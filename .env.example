# ============ ONLAYN TO'LOV: MULTICARD ============
# Kalitlarni Multicard beradi. Bu faylga haqiqiy qiymat yozmang — faqat .env ga (va Render → Environment ga)
# Test: https://dev-mesh.multicard.uz   Production: https://mesh.multicard.uz
MULTICARD_BASE_URL="https://dev-mesh.multicard.uz"
MULTICARD_APPLICATION_ID=""
MULTICARD_SECRET=""
MULTICARD_STORE_ID=""
# (ixtiyoriy) Callback faqat shu IP dan qabul qilinsin (hujjat: 195.158.26.90). Bo'sh — faqat imzo tekshiriladi
MULTICARD_CALLBACK_IP=""
# Invoys amal qilish muddati, soniya
MULTICARD_INVOICE_TTL=3600
# Callback manzili uchun server manzili (Render'da avtomatik — RENDER_EXTERNAL_URL)
PUBLIC_URL=""

