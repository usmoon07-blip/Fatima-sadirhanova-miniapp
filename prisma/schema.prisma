generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// PENDING — to'lov kutilmoqda, PAID — to'landi (kurs ochildi), CANCELLED — bekor qilindi
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  firstName  String?
  lastName   String?
  username   String?
  phone      String?
  /// Tanlangan til: uz | ru | en
  language   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
  reviews    Review[]
  accesses   CourseAccess[]
}

/// Kurs (mahsulot)
model Course {
  id           Int      @id @default(autoincrement())
  title        String
  titleRu      String?
  titleEn      String?
  description  String   @default("")
  descriptionRu String?
  descriptionEn String?
  imageUrl     String
  oldPrice     Int?
  price        Int
  category     String   @default("Tortlar")
  categoryRu   String?
  categoryEn   String?
  /// Kurs dasturi — har bir element alohida mavzu
  program      String[] @default([])
  programRu    String[] @default([])
  programEn    String[] @default([])
  lessonsCount Int      @default(0)
  duration     String?
  durationRu   String?
  durationEn   String?
  level        String?
  levelRu      String?
  levelEn      String?
  badge        String?
  /// Yopiq kanal (bot admin qilingan). To'lovdan keyin har bir o'quvchiga bir martalik havola yaratiladi
  channelId    String?
  /// Ochiq havola — kanal tanlanmagan bo'lsa yuboriladi (himoyasiz, eski usul)
  accessLink   String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviews      Review[]
  accesses     CourseAccess[]
}

model Order {
  id           Int         @id @default(autoincrement())
  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ courseId, title, imageUrl, price, oldPrice, type: "course" | "extra" }]
  items        Json
  total        Int
  customerName String
  phone        String
  comment      String?
  /// To'lov cheki rasmi (/uploads/...)
  receiptUrl   String?
  receiptAt    DateTime?
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

/// Kursni sotib olgan o'quvchining izohi
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  text      String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

/// O'quvchilar natijalari (galereya)
model Result {
  id          Int      @id @default(autoincrement())
  studentName String
  courseTitle String?
  imageUrl    String
  text        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Story {
  id        Int      @id @default(autoincrement())
  title     String
  titleRu   String?
  titleEn   String?
  imageUrl  String
  text      String?
  textRu    String?
  textEn    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Yuklangan rasmlar bazada saqlanadi (bepul serverlarda disk vaqtinchalik)
model Upload {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}

/// Admin Paneldan o'zgartiriladigan sozlamalar (karta raqami va h.k.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Bot admin qilingan Telegram kanallar (bot o'zi yozib boradi)
model Channel {
  id        String   @id
  title     String
  username  String?
  canInvite Boolean  @default(false)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// O'quvchining kursga kirish havolasi: bir martalik, faqat shu o'quvchi uchun
model CourseAccess {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  channelId  String
  inviteLink String
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, courseId])
  @@index([inviteLink])
}
