generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// PENDING — to'lov kutilmoqda, PAID — to'landi (kurs ochildi), CANCELLED — bekor qilindi
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  firstName  String?
  lastName   String?
  username   String?
  phone      String?
  /// Tanlangan til: uz | ru | en
  language   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
  reviews    Review[]
  accesses   CourseAccess[]
}

/// Kurs (mahsulot)
model Course {
  id           Int      @id @default(autoincrement())
  title        String
  titleRu      String?
  titleEn      String?
  description  String   @default("")
  descriptionRu String?
  descriptionEn String?
  imageUrl     String
  oldPrice     Int?
  price        Int
  category     String   @default("Tortlar")
  categoryRu   String?
  categoryEn   String?
  /// Kurs dasturi — har bir element alohida mavzu
  program      String[] @default([])
  programRu    String[] @default([])
  programEn    String[] @default([])
  lessonsCount Int      @default(0)
  duration     String?
  durationRu   String?
  durationEn   String?
  level        String?
  levelRu      String?
  levelEn      String?
  badge        String?
  /// Yopiq kanal (bot admin qilingan). To'lovdan keyin har bir o'quvchiga bir martalik havola yaratiladi
  channelId    String?
  /// Ochiq havola — kanal tanlanmagan bo'lsa yuboriladi (himoyasiz, eski usul)
  accessLink   String?
  /// Fiskal chek (OFD): MXIK (IKPU) kodi, qadoq kodi va QQS foizi — tasnif.soliq.uz dan
  mxik         String?
  packageCode  String?
  vat          Int?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviews      Review[]
  accesses     CourseAccess[]
}

model Order {
  id           Int         @id @default(autoincrement())
  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ courseId, title, imageUrl, price, oldPrice, type: "course" | "extra" }]
  items        Json
  /// Jami summa (so'm). To'lov tizimiga tiyinda yuboriladi va Payment jadvalida tiyinda saqlanadi
  total        Int
  /// To'lov usuli: "multicard" (onlayn) yoki "manual" (eski: kartaga o'tkazma + chek)
  paymentMethod String     @default("multicard")
  customerName String
  phone        String
  comment      String?
  /// To'lov cheki rasmi (/uploads/...)
  receiptUrl   String?
  receiptAt    DateTime?
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  payments     Payment[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

/// To'lov holati. PAID ga faqat to'lov tizimining tasdiqlangan (imzosi to'g'ri) callback'i bilan o'tadi
enum PaymentStatus {
  CREATED
  PAID
  CANCELLED
  REFUNDED
}

/// Bitta to'lov urinishi (bitta arizaga bir nechta bo'lishi mumkin, masalan muddati o'tib qayta yaratilsa)
model Payment {
  id              Int           @id @default(autoincrement())
  orderId         Int
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String        @default("multicard")
  /// To'lov tizimiga yuborilgan bizning identifikator (invoice_id) — noyob
  invoiceId       String        @unique
  /// Summa TIYINDA (1 so'm = 100 tiyin)
  amount          Int
  status          PaymentStatus @default(CREATED)
  /// Multicard'dagi invoys uuid (yaratilganda qaytadi)
  invoiceUuid     String?       @unique
  /// Multicard'dagi tranzaksiya uuid (callback'da keladi) — takroriy callback'ni aniqlash uchun
  transactionUuid String?       @unique
  checkoutUrl     String?
  receiptUrl      String?
  cardPan         String?
  ps              String?
  billingId       String?
  paidAt          DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  logs            PaymentLog[]

  @@index([orderId])
  @@index([status])
}

/// To'lov tizimi bilan har bir so'rov va javob (out — biz yuborgan, in — bizga kelgan)
model PaymentLog {
  id         Int      @id @default(autoincrement())
  provider   String   @default("multicard")
  direction  String
  endpoint   String
  paymentId  Int?
  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  httpStatus Int?
  request    Json?
  response   Json?
  note       String?
  createdAt  DateTime @default(now())

  @@index([paymentId])
  @@index([createdAt])
}

/// Kursni sotib olgan o'quvchining izohi
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  text      String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

/// O'quvchilar natijalari (galereya)
model Result {
  id          Int      @id @default(autoincrement())
  studentName String
  courseTitle String?
  imageUrl    String
  text        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Story {
  id        Int      @id @default(autoincrement())
  title     String
  titleRu   String?
  titleEn   String?
  imageUrl  String
  text      String?
  textRu    String?
  textEn    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Yuklangan rasmlar bazada saqlanadi (bepul serverlarda disk vaqtinchalik)
model Upload {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}

/// Admin Paneldan o'zgartiriladigan sozlamalar (karta raqami va h.k.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Bot admin qilingan Telegram kanallar (bot o'zi yozib boradi)
model Channel {
  id        String   @id
  title     String
  username  String?
  canInvite Boolean  @default(false)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// O'quvchining kursga kirish havolasi: bir martalik, faqat shu o'quvchi uchun
model CourseAccess {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  channelId  String
  inviteLink String
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, courseId])
  @@index([inviteLink])
}
