generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  CARD
}

enum CourseFormat {
  ONLINE
  OFFLINE
}

enum EnrollmentStatus {
  NEW
  CONFIRMED
  PAID
  COMPLETED
  CANCELLED
}

enum PromoType {
  PERCENT
  FIXED
}

model User {
  id           Int          @id @default(autoincrement())
  telegramId   String       @unique
  firstName    String?
  lastName     String?
  username     String?
  phone        String?
  languageCode String?
  /// Tanlangan til: uz | ru | en
  language     String?
  address      String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orders       Order[]
  enrollments  Enrollment[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  nameRu    String?
  nameEn    String?
  imageUrl  String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id            Int       @id @default(autoincrement())
  name          String
  nameRu        String?
  nameEn        String?
  description   String    @default("")
  descriptionRu String?
  descriptionEn String?
  imageUrl      String
  oldPrice      Int?
  price         Int
  categoryId    Int?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ingredients   String[]  @default([])
  ingredientsRu String[]  @default([])
  ingredientsEn String[]  @default([])
  /// Variantlar: [{ "label": "6 inch", "price": 249000 }]
  sizes         Json      @default("[]")
  rating        Float     @default(5)
  reviewsCount  Int       @default(0)
  badge         String?
  isPopular     Boolean   @default(false)
  isAvailable   Boolean   @default(true)
  isUpsell      Boolean   @default(false)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([categoryId])
}

model Story {
  id        Int      @id @default(autoincrement())
  title     String
  titleRu   String?
  titleEn   String?
  imageUrl  String
  text      String?
  textRu    String?
  textEn    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ productId, name, imageUrl, size, price, quantity, total }]
  items         Json
  subtotal      Int
  discount      Int           @default(0)
  promoCode     String?
  deliveryFee   Int           @default(0)
  total         Int
  deliveryType  DeliveryType
  paymentMethod PaymentMethod
  customerName  String
  phone         String
  address       String?
  latitude      Float?
  longitude     Float?
  deliveryTime  String?
  comment       String?
  status        OrderStatus   @default(NEW)
  statusAt      DateTime      @default(now())
  cancelledBy   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model PromoCode {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  description    String    @default("")
  descriptionRu  String?
  descriptionEn  String?
  type           PromoType @default(PERCENT)
  /// PERCENT bo'lsa foiz (1-100), FIXED bo'lsa so'm
  value          Int
  /// Foizli chegirma uchun maksimal summa (so'm)
  maxDiscount    Int?
  minOrder       Int       @default(0)
  expiresAt      DateTime?
  usageLimit     Int?
  usedCount      Int       @default(0)
  firstOrderOnly Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model Course {
  id            Int          @id @default(autoincrement())
  title         String
  titleRu       String?
  titleEn       String?
  description   String       @default("")
  descriptionRu String?
  descriptionEn String?
  /// Dastur: har bir element — bitta mavzu
  program       String[]     @default([])
  programRu     String[]     @default([])
  programEn     String[]     @default([])
  duration      String?
  durationRu    String?
  durationEn    String?
  imageUrl      String
  /// null — bu formatda o'tilmaydi
  onlinePrice   Int?
  offlinePrice  Int?
  badge         String?
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  enrollments   Enrollment[]
}

/// Kursga yozilish arizasi
model Enrollment {
  id            Int              @id @default(autoincrement())
  userId        Int
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      Int?
  course        Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseTitle   String
  format        CourseFormat
  price         Int
  customerName  String
  phone         String
  paymentMethod PaymentMethod
  comment       String?
  status        EnrollmentStatus @default(NEW)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([userId])
}
