generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// PENDING — to'lov kutilmoqda, PAID — to'landi (kurs ochildi), CANCELLED — bekor qilindi
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId String   @unique
  firstName  String?
  lastName   String?
  username   String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
  reviews    Review[]
}

/// Kurs (mahsulot)
model Course {
  id           Int      @id @default(autoincrement())
  title        String
  description  String   @default("")
  imageUrl     String
  oldPrice     Int?
  price        Int
  category     String   @default("Tortlar")
  /// Kurs dasturi — har bir element alohida mavzu
  program      String[] @default([])
  lessonsCount Int      @default(0)
  duration     String?
  level        String?
  badge        String?
  /// Yopiq kanal / guruh havolasi — to'lov tasdiqlangach o'quvchiga yuboriladi
  accessLink   String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reviews      Review[]
}

model Order {
  id           Int         @id @default(autoincrement())
  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [{ courseId, title, imageUrl, price, oldPrice, type: "course" | "extra" }]
  items        Json
  total        Int
  customerName String
  phone        String
  comment      String?
  /// To'lov cheki rasmi (/uploads/...)
  receiptUrl   String?
  receiptAt    DateTime?
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

/// Kursni sotib olgan o'quvchining izohi
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  text      String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([courseId])
}

/// O'quvchilar natijalari (galereya)
model Result {
  id          Int      @id @default(autoincrement())
  studentName String
  courseTitle String?
  imageUrl    String
  text        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Story {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String
  text      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Yuklangan rasmlar bazada saqlanadi (bepul serverlarda disk vaqtinchalik)
model Upload {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}

/// Admin Paneldan o'zgartiriladigan sozlamalar (karta raqami va h.k.)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
